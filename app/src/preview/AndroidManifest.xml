<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application android:label="SWU Collection Test" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_test" android:roundIcon="@mipmap/ic_launcher_test"
        tools:replace="android:label,android:allowBackup,android:icon,android:roundIcon">
        <activity android:name=".MainActivity" android:resizeableActivity="true" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|fontScale|density"
            tools:replace="android:configChanges" />
    </application>
</manifest>
