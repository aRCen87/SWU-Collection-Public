rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function enabled(uid) {
      return exists(/databases/$(database)/documents/testMembers/$(uid)) &&
        get(/databases/$(database)/documents/testMembers/$(uid)).data.enabled == true;
    }
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function allowed() { return verified() && enabled(request.auth.uid); }
    function unblocked(a, b) {
      return !exists(/databases/$(database)/documents/blocks/$(a)/users/$(b)) &&
        !exists(/databases/$(database)/documents/blocks/$(b)/users/$(a));
    }
    function friends(a, b) {
      return (exists(/databases/$(database)/documents/friendships/$(a + '__' + b)) &&
        get(/databases/$(database)/documents/friendships/$(a + '__' + b)).data.status == 'accepted') ||
        (exists(/databases/$(database)/documents/friendships/$(b + '__' + a)) &&
        get(/databases/$(database)/documents/friendships/$(b + '__' + a)).data.status == 'accepted');
    }
    function acceptsMessages(a, b) {
      return !exists(/databases/$(database)/documents/profiles/$(b)) ||
        get(/databases/$(database)/documents/profiles/$(b)).data.get('messagePolicy', 'testers') == 'testers' ||
        (get(/databases/$(database)/documents/profiles/$(b)).data.get('messagePolicy', 'testers') == 'friends' && friends(a, b));
    }
    function visibleProfile(uid) {
      return request.auth.uid == uid || get(/databases/$(database)/documents/profiles/$(uid)).data.discoverable == true || friends(request.auth.uid, uid);
    }
    function validMembers(m) {
      return m is list && m.size() == 2 && m[0] is string && m[1] is string && m[0] != m[1] &&
        request.auth.uid in m && enabled(m[0]) && enabled(m[1]) && unblocked(m[0], m[1]);
    }
    function validProfile(d) {
      return d.keys().hasAll(['name','bio','avatar','discoverable','shareBadges','badgeIds','updatedAt']) &&
        d.keys().hasOnly(['name','bio','avatar','discoverable','shareBadges','badgeIds','updatedAt','messagePolicy','shareDecks','city','cityKey','formats','leaders','shareShowcase']) &&
        d.name is string && d.name.size() >= 2 && d.name.size() <= 32 &&
        d.bio is string && d.bio.size() <= 200 &&
        d.avatar is string && d.avatar.size() <= 18000 &&
        (d.avatar.matches('preset:(star|moon|planet|robot|ship|comet|sun|crystal)') || d.avatar.matches('jpeg:[A-Za-z0-9+/=]+')) &&
        d.discoverable is bool && d.shareBadges is bool && d.badgeIds is list && d.badgeIds.size() <= 500 &&
        (d.shareBadges || d.badgeIds.size() == 0) && d.get('messagePolicy', 'testers') in ['testers','friends','nobody'] &&
        d.get('shareDecks', false) is bool && d.get('city', '') is string && d.get('city', '').size() <= 60 &&
        d.get('cityKey', '') is string && d.get('cityKey', '').size() <= 120 &&
        d.get('formats', []) is list && d.get('formats', []).size() <= 5 &&
        d.get('formats', []).hasOnly(['Premier','Éternel','Twin Suns','Draft','Scellé']) &&
        d.get('leaders', []) is list && d.get('leaders', []).size() <= 3 &&
        d.get('shareShowcase', false) is bool && d.updatedAt == request.time;
    }
    match /testMembers/{uid} {
      // A verified account may join once. Only an administrator may change or
      // remove membership, so a disabled account cannot re-enable itself.
      allow get: if verified() && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['enabled','selfRegistered','joinedAt']) &&
        request.resource.data.keys().hasOnly(['enabled','selfRegistered','joinedAt']) &&
        request.resource.data.enabled == true && request.resource.data.selfRegistered == true &&
        request.resource.data.joinedAt == request.time;
      allow list, update, delete: if false;
    }
    // Firestore reads whole documents: keep real names outside discoverable profiles.
    match /profileNames/{uid} {
      allow get: if allowed() && (request.auth.uid == uid ||
        (resource.data.shareFirstName == true && enabled(uid) && friends(request.auth.uid, uid) && unblocked(request.auth.uid, uid)));
      allow list: if false;
      allow create, update: if allowed() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['firstName','shareFirstName','updatedAt']) &&
        request.resource.data.keys().hasOnly(['firstName','shareFirstName','updatedAt']) &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() <= 40 &&
        request.resource.data.shareFirstName is bool && request.resource.data.updatedAt == request.time;
      allow delete: if allowed() && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow get: if allowed() && (request.auth.uid == uid || resource.data.discoverable == true || friends(request.auth.uid, uid));
      allow list: if allowed() && resource.data.discoverable == true && request.query.limit != null && request.query.limit <= 50;
      allow create, update: if allowed() && request.auth.uid == uid && validProfile(request.resource.data);
      allow delete: if allowed() && request.auth.uid == uid;
      match /showcase/{item} {
        function maySee() { return allowed() && (request.auth.uid == uid ||
          (enabled(uid) && unblocked(request.auth.uid, uid) && visibleProfile(uid) &&
            get(/databases/$(database)/documents/profiles/$(uid)).data.get('shareShowcase', false) == true)); }
        allow get: if maySee();
        allow list: if maySee() && request.query.limit != null && request.query.limit <= 12;
        allow create, update: if allowed() && request.auth.uid == uid &&
          item.matches('[A-Za-z0-9_-]{1,120}') &&
          request.resource.data.keys().hasAll(['set','number','variant','language','caption','updatedAt']) &&
          request.resource.data.keys().hasOnly(['set','number','variant','language','caption','updatedAt']) &&
          request.resource.data.set is string && request.resource.data.set.matches('[A-Z0-9]{2,12}') &&
          request.resource.data.number is string && request.resource.data.number.matches('[0-9]{1,5}') &&
          request.resource.data.variant is string && request.resource.data.variant.size() <= 60 &&
          request.resource.data.language in ['FR','EN','DE','ES','IT'] &&
          request.resource.data.caption is string && request.resource.data.caption.size() <= 160 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if allowed() && request.auth.uid == uid;
      }
      match /decks/{deck} {
        function mayRead() { return allowed() && (request.auth.uid == uid ||
          (visibleProfile(uid) && get(/databases/$(database)/documents/profiles/$(uid)).data.get('shareDecks', false) == true)); }
        allow get: if mayRead();
        allow list: if mayRead() && request.query.limit != null && request.query.limit <= 20;
        allow create, update: if allowed() && request.auth.uid == uid &&
          request.resource.data.keys().hasAll(['name','deckJson','updatedAt']) && request.resource.data.keys().hasOnly(['name','deckJson','updatedAt']) &&
          request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120 &&
          request.resource.data.deckJson is string && request.resource.data.deckJson.size() >= 2 && request.resource.data.deckJson.size() <= 40000 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if allowed() && request.auth.uid == uid;
      }
    }
    match /showcaseFavorites/{uid}/items/{favorite} {
      allow get: if allowed() && request.auth.uid == uid;
      allow list: if allowed() && request.auth.uid == uid && request.query.limit != null && request.query.limit <= 100;
      allow create, update: if allowed() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['owner','item','createdAt']) && request.resource.data.keys().hasOnly(['owner','item','createdAt']) &&
        request.resource.data.owner is string && request.resource.data.owner != uid && request.resource.data.owner.size() <= 128 &&
        request.resource.data.item is string && request.resource.data.item.matches('[A-Za-z0-9_-]{1,120}') &&
        favorite == request.resource.data.owner + '__' + request.resource.data.item &&
        enabled(request.resource.data.owner) && unblocked(uid, request.resource.data.owner) && visibleProfile(request.resource.data.owner) &&
        get(/databases/$(database)/documents/profiles/$(request.resource.data.owner)).data.get('shareShowcase', false) == true &&
        exists(/databases/$(database)/documents/profiles/$(request.resource.data.owner)/showcase/$(request.resource.data.item)) &&
        request.resource.data.createdAt == request.time;
      allow delete: if allowed() && request.auth.uid == uid;
    }
    match /friendships/{pair} {
      allow get: if allowed() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if allowed() && request.auth.uid in resource.data.members && request.query.limit != null && request.query.limit <= 100;
      allow create: if allowed() && validMembers(request.resource.data.members) &&
        pair == request.resource.data.members[0] + '__' + request.resource.data.members[1] &&
        request.resource.data.keys().hasAll(['members','requester','status','updatedAt']) && request.resource.data.keys().hasOnly(['members','requester','status','updatedAt','requesterName','requesterAvatar']) &&
        request.resource.data.requester == request.auth.uid && request.resource.data.status == 'pending' &&
        (!('requesterName' in request.resource.data) || request.resource.data.requesterName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name) &&
        (!('requesterAvatar' in request.resource.data) || request.resource.data.requesterAvatar == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.avatar) &&
        request.resource.data.updatedAt == request.time;
      allow update: if allowed() && validMembers(resource.data.members) && request.auth.uid != resource.data.requester &&
        resource.data.status == 'pending' && request.resource.data.status == 'accepted' && request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if allowed() && request.auth.uid in resource.data.members;
    }
    match /reads/{uid}/threads/{thread} {
      allow get: if allowed() && request.auth.uid == uid;
      allow list: if allowed() && request.auth.uid == uid && request.query.limit != null && request.query.limit <= 100;
      allow create, update: if allowed() && request.auth.uid == uid &&
        uid in get(/databases/$(database)/documents/conversations/$(thread)).data.members &&
        request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt == request.time;
      allow delete: if allowed() && request.auth.uid == uid;
    }
    match /trades/{trade} {
      allow get: if allowed() && request.auth.uid in resource.data.members;
      allow list: if allowed() && request.auth.uid in resource.data.members && request.query.limit != null && request.query.limit <= 100;
      allow create: if allowed() && validMembers(request.resource.data.members) &&
        friends(request.resource.data.members[0], request.resource.data.members[1]) &&
        request.resource.data.keys().hasAll(['members','requester','status','offer','wanted','createdAt','updatedAt']) &&
        request.resource.data.keys().hasOnly(['members','requester','status','offer','wanted','createdAt','updatedAt']) &&
        request.resource.data.requester == request.auth.uid && request.resource.data.status == 'pending' &&
        request.resource.data.offer is string && request.resource.data.offer.size() >= 2 && request.resource.data.offer.size() <= 8000 &&
        request.resource.data.wanted is string && request.resource.data.wanted.size() >= 2 && request.resource.data.wanted.size() <= 8000 &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if allowed() && request.auth.uid in resource.data.members && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.updatedAt == request.time &&
        ((request.auth.uid == resource.data.requester && request.resource.data.status == 'cancelled') ||
         (request.auth.uid != resource.data.requester && (request.resource.data.status == 'declined' ||
          (request.resource.data.status == 'accepted' && validMembers(resource.data.members) && friends(resource.data.members[0], resource.data.members[1])))));
      allow delete: if false;
    }
    match /blocks/{uid}/users/{peer} {
      allow read: if allowed() && request.auth.uid == uid;
      allow create, update: if allowed() && request.auth.uid == uid && peer != uid &&
        request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      allow delete: if allowed() && request.auth.uid == uid;
    }
    match /conversations/{conversation} {
      allow get: if allowed() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if allowed() && request.auth.uid in resource.data.members && request.query.limit != null && request.query.limit <= 100;
      allow create: if allowed() && request.resource.data.keys().hasOnly(['members','updatedAt']) &&
        validMembers(request.resource.data.members) && acceptsMessages(request.auth.uid,
          request.resource.data.members[request.resource.data.members[0] == request.auth.uid ? 1 : 0]) && request.resource.data.updatedAt == request.time;
      allow update: if allowed() && validMembers(resource.data.members) &&
        acceptsMessages(request.auth.uid, resource.data.members[resource.data.members[0] == request.auth.uid ? 1 : 0]) &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastSenderId']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId']) ||
          request.resource.data.lastSenderId == request.auth.uid) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /messages/{message} {
        function participant() {
          return allowed() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversation)).data.members;
        }
        function validMessage(d) {
          let m = getAfter(/databases/$(database)/documents/conversations/$(conversation)).data.members;
          return allowed() && validMembers(m) && acceptsMessages(request.auth.uid, m[m[0] == request.auth.uid ? 1 : 0]) &&
            d.keys().hasAll(['senderId','kind','text','deckName','deckJson','createdAt']) &&
            d.keys().hasOnly(['senderId','kind','text','deckName','deckJson','createdAt']) &&
            d.senderId == request.auth.uid && d.text is string && d.text.size() <= 2000 &&
            d.deckName is string && d.deckName.size() <= 120 && d.deckJson is string && d.deckJson.size() <= 40000 &&
            ((d.kind == 'text' && d.text.size() >= 1 && d.deckJson == '' && d.deckName == '') ||
             (d.kind == 'deck' && d.deckName.size() >= 1 && d.deckJson.size() >= 2)) && d.createdAt == request.time;
        }
        allow get: if participant();
        allow list: if participant() && request.query.limit != null && request.query.limit <= 50;
        allow create: if validMessage(request.resource.data);
        allow update, delete: if false;
      }
    }
    // Account snapshots are private, immutable and available only to their owner.
    match /accountBackups/{uid} {
      function owner() { return allowed() && request.auth.uid == uid; }
      allow get: if owner();
      allow list, delete: if false;
      allow create, update: if owner() && request.resource.data.keys().hasAll(['head','updatedAt']) &&
        request.resource.data.keys().hasOnly(['head','updatedAt']) && request.resource.data.head is string &&
        request.resource.data.head.matches('[a-f0-9-]{36}') && request.resource.data.updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/accountBackups/$(uid)/snapshots/$(request.resource.data.head));
      match /snapshots/{snapshot} {
        allow get: if owner();
        allow list: if owner() && request.query.limit != null && request.query.limit <= 3;
        allow create: if owner() && snapshot.matches('[a-f0-9-]{36}') &&
          request.resource.data.keys().hasAll(['parts','bytes','hash','createdAt']) &&
          request.resource.data.keys().hasOnly(['parts','bytes','hash','createdAt']) &&
          request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 32 &&
          request.resource.data.bytes is int && request.resource.data.bytes >= 1 && request.resource.data.bytes <= 16777216 &&
          request.resource.data.hash is string && request.resource.data.hash.matches('[a-f0-9]{64}') &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
        match /chunks/{part} {
          allow get: if owner();
          allow list, update, delete: if false;
          allow create: if owner() && part.matches('[0-9]{1,2}') &&
            request.resource.data.keys().hasAll(['index','data']) && request.resource.data.keys().hasOnly(['index','data']) &&
            request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index <
              getAfter(/databases/$(database)/documents/accountBackups/$(uid)/snapshots/$(snapshot)).data.parts &&
            request.resource.data.data is string && request.resource.data.data.size() >= 1 && request.resource.data.data.size() <= 200000;
        }
      }
    }
    // A voluntarily published list exposes offers/wants, never the full collection.
    match /tradeInventories/{uid} {
      function owner() { return allowed() && request.auth.uid == uid; }
      allow get: if allowed() && (request.auth.uid == uid || (enabled(uid) && friends(request.auth.uid,uid) && unblocked(request.auth.uid,uid)));
      allow list: if false;
      allow create, update: if owner() && request.resource.data.keys().hasAll(['encoded','hash','updatedAt']) &&
        request.resource.data.keys().hasOnly(['encoded','hash','updatedAt']) && request.resource.data.encoded is string &&
        request.resource.data.encoded.size() >= 1 && request.resource.data.encoded.size() <= 600000 &&
        request.resource.data.hash is string && request.resource.data.hash.matches('[a-f0-9]{64}') && request.resource.data.updatedAt == request.time;
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
